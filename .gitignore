# Data, by lifecycle. Committed only where it is small, curated, and not reproducible.
#
#   parqet/     IMPORTED — regenerate via REFRESH_PARQET_DATA.md. Ignored: holds real position
#                          values and share counts.
#   prices/     DERIVED  — regenerate via update_prices.py. Ignored: bulk, and reproducible from
#   fx/         DERIVED    registry/price_sources.csv alone.
#   registry/   CURATED  — COMMITTED. Two small tables no import can rebuild. Note that
#                          instruments.csv does enumerate which instruments are held.
*.csv
parqet/
prices/
fx/
!registry/*.csv

# check_portfolio.js records real position values and tooltips here — same rule as parqet/
check_baseline.json

.DS_Store
__pycache__/
